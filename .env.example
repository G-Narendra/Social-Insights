# ============================================================================
# Social Insights - Environment Configuration
# ============================================================================
# Copy this file to .env and fill in values. Only DATABASE_URL is required.
# The app runs with reduced features when optional keys are missing.
# ============================================================================

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQLite (local development): sqlite+aiosqlite:///./social_insights.db
# PostgreSQL (production):    postgresql+asyncpg://user:pass@host:port/dbname
DATABASE_URL=sqlite+aiosqlite:///./social_insights.db

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development
# Secret used to protect /internal/* endpoints. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_SECRET=change-me-to-a-random-secret
# Comma-separated origins for CORS (e.g., http://localhost:3000,https://your-frontend.vercel.app)
CORS_ORIGINS=http://localhost:3000
# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Reddit API (optional - connector disables itself without these)
# ---------------------------------------------------------------------------
# Create a "script" app at https://www.reddit.com/prefs/apps
# Free tier: 60 requests/minute with OAuth
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=SocialInsights/1.0 (by /u/YOUR_USERNAME)

# ---------------------------------------------------------------------------
# YouTube Data API v3 (optional - connector disables itself without this)
# ---------------------------------------------------------------------------
# Get a key at https://console.cloud.google.com/apis/credentials
# Free quota: 10,000 units/day; search costs 100 units, comments cost 1 unit
YOUTUBE_API_KEY=

# ---------------------------------------------------------------------------
# NVIDIA NIM API (optional - falls back to template summaries without this)
# ---------------------------------------------------------------------------
# Sign up at https://build.nvidia.com and get an API key
# Free tier: ~1000 credits, ~40 requests/minute
# Used ONLY for summaries/insights on aggregated data, not per-mention
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# ---------------------------------------------------------------------------
# AI/ML Configuration
# ---------------------------------------------------------------------------
# Max mentions sent to LLM per run (controls cost)
LLM_MAX_ITEMS_PER_RUN=20
# Confidence threshold below which items go to LLM for re-classification
CONFIDENCE_THRESHOLD=0.6
# Cosine similarity threshold for near-duplicate detection
DEDUP_SIMILARITY_THRESHOLD=0.92
# Minimum text length to keep a mention (characters)
MIN_TEXT_LENGTH=30

# ---------------------------------------------------------------------------
# Model cache directories (project-local, never global)
# ---------------------------------------------------------------------------
HF_HOME=./.cache/huggingface
TRANSFORMERS_CACHE=./.cache/huggingface
SENTENCE_TRANSFORMERS_HOME=./.cache/sbert
