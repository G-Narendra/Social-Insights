# ==============================================================================
# Social Insights — Environment Configuration Example
# Copy this file to .env before starting the platform: cp .env.example .env
# ==============================================================================

# Application Environment (development, testing, production)
APP_ENV=development
LOG_LEVEL=INFO
PORT=8000

# Database Connection URL
# SQLite default: sqlite+aiosqlite:///./social_insights.db
# PostgreSQL: postgresql+asyncpg://postgres:postgres_secure_pass@localhost:5432/social_insights
DATABASE_URL=sqlite+aiosqlite:///./social_insights.db

# CORS Allowed Origins (comma-separated list, never use wildcard '*' in production)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Secret for triggering background ingestion cron jobs (/internal/ingest)
INTERNAL_SECRET=dev-internal-secret-change-in-production

# LLM Synthesis: NVIDIA NIM API (Free Tier)
# Request key at: https://build.nvidia.com
# If omitted, platform gracefully falls back to Tier 3 deterministic templates
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# Ingestion Source Credentials (Optional — free public APIs work without keys)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
YOUTUBE_API_KEY=

# Local Machine Learning Cache Directories
HF_HOME=./.cache/huggingface
SENTENCE_TRANSFORMERS_HOME=./.cache/sbert
TORCH_NUM_THREADS=2
